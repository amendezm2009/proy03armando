APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX
APP_TIMEZONE=America/Mexico_City

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Cifrado de contraseñas: Argon2id. HASH_VERIFY=false deja entrar a quien aún tiene una
# contraseña bcrypt y la convierte a Argon2id en su siguiente inicio de sesión.
HASH_DRIVER=argon2id
HASH_VERIFY=false
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
# Seguridad (config/security.php): CSP enforce | report-only | off; HSTS solo se envía por HTTPS.
# php artisan security:check revisa estos valores y los de la sesión.
SECURITY_CSP=enforce
SECURITY_HSTS=true
SECURITY_LOG_DAYS=90
SESSION_PATH=/
SESSION_DOMAIN=null

# Minutos de vida de los tokens de la API (480 = 8 horas)
SANCTUM_TOKEN_EXPIRATION=480

# Límite de peticiones: 60 por minuto, por usuario o por IP si no hay token.
# Al superarlo responde 429 en JSON con la cabecera Retry-After.
API_REQUESTS_PER_MINUTE=60

# Intentos por minuto y por IP en las rutas de acceso (web y API). 
# Al superarlos responde código http 429.
LOGIN_ATTEMPTS_PER_MINUTE=10
REGISTER_ATTEMPTS_PER_MINUTE=5
PASSWORD_ATTEMPTS_PER_MINUTE=5
INVITATION_ATTEMPTS_PER_MINUTE=5
AVATAR_ATTEMPTS_PER_MINUTE=10

# Confirmar la contraseña de quien ya tiene sesión (cambio de contraseña, acciones sensibles):
# tras este número de fallos se cierra su sesión; el contador caduca a los 900 segundos (15 minutos).
PASSWORD_CONFIRMATION_MAX_ATTEMPTS=3
PASSWORD_CONFIRMATION_DECAY_SECONDS=900

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Versiones y despliegue (config/release.php). La clave privada de firma vive FUERA del proyecto; solo en desarrollo.
RELEASE_SIGNING_KEY_FILE=
RELEASE_PART_SIZE_MB=9
# Valor secreto para que los scripts de despliegue lean la versión instalada en /health (cabecera X-Health-Token). Vacío = nadie la lee.
HEALTH_TOKEN=
HEALTH_REQUESTS_PER_MINUTE=30

# Respaldos de la base de datos (config/backup.php). Vacío = storage/app/private/backups. Los respaldos llevan datos de usuarios: carpeta privada.
BACKUP_DIRECTORY=
BACKUP_KEEP=10
